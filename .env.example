DB_NAME=belmonte
DB_USER=belmonte
DB_PASSWORD=belmonte_dev
DB_ROOT_PASSWORD=root_dev
DB_PORT=3307
DB_URL=jdbc:mariadb://localhost:3307/belmonte
SMTP_PORT=1025
SMTP_UI_PORT=8025

# Correo de desarrollo (Mailpit): variables de la APLICACIÓN, no de docker compose.
# Defínelas en el entorno o en la configuración de ejecución del IDE; los correos se
# leen en http://localhost:8025. Mailpit acepta cualquier usuario y clave, pero la app
# exige que estén definidos (por defecto autentica); sin ellos el envío falla.
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=dev
# SPRING_MAIL_PASSWORD=dev
